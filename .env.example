# ---------------------------------------------------------------------------
# Team Calendar Overview – environment
# The setup wizard (/setup) or `php artisan calendar:install` fills this in.
# ---------------------------------------------------------------------------

APP_NAME="Calendar overview"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://calendar.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

# Database: "sqlite" needs no configuration. For MySQL/MariaDB fill in DB_HOST etc.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=calendar
# DB_USERNAME=calendar
# DB_PASSWORD=

# Microsoft Entra ID app registration (delegated, read-only permissions)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: comma-separated e-mail domains allowed to sign in (empty = everyone in the tenant)
MS_ALLOWED_DOMAINS=

# How long cached data is reused before Microsoft Graph is asked again
CALENDAR_SCHEDULE_TTL_MINUTES=10
CALENDAR_DIRECTORY_SYNC_HOURS=24
CALENDAR_PHOTO_SYNC_DAYS=7
CALENDAR_GROUP_SYNC_HOURS=24

# Refresh a signed-in user's Microsoft token when it has been expired this long (catches disabled accounts)
CALENDAR_REVALIDATE_MINUTES=60

# Strict-Transport-Security max-age in seconds (0 = do not send the header)
HSTS_MAX_AGE=31536000
# Reverse proxies whose X-Forwarded-* headers may be trusted (comma-separated, or "*"). Empty = none.
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=log
